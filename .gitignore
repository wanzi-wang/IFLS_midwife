# =====================================================================
# .gitignore — Indonesia Village Midwife Project
# =====================================================================

# --- OS / editor ---
.DS_Store
.Rproj.user/
.Rhistory
.RData
.Rapp.history
*.swp
*~

# --- Claude harness / local state (entire dir; not part of public repo) ---
memory/

# --- Internal working artifacts (not part of public repo) ---
audit_reports/
attic/
templates/
scripts/quality_score.py
.history-cleanup/

# --- Data (restricted IFLS, large, or regenerable) ---
data/raw/
data/intermediate/*
!data/intermediate/.gitkeep
*.dta
*.sav
*.sas7bdat
# .rds is intermediate-data-only; keep tracked if explicitly added under code/R/lib/
data/intermediate/*.rds

# --- Hard block: IFLS-derived community/household extracts (restricted-use) ---
# Filename patterns from the IFLS SAR/PKK community modules and common extracts.
# If any of these ever get generated by the pipeline, they must NOT be committed.
**/sar_*.csv
**/pkk_*.csv
**/sar_pkk_*.csv
**/ar0*.csv
**/ar1*.csv
**/b3a_*.csv
**/bus_us*.csv
**/ifls*.csv
**/ifls*.rds

# --- R build / cache ---
renv/library/
renv/staging/
renv/local/
.Rproj.user/
*.rds.bak

# --- LaTeX auxiliary ---
*.aux
*.bbl
*.blg
*.bcf
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv
*.idx
*.ind
*.ilg
*-blx.bib

# --- Build output (PDFs are typically re-built; un-comment to track) ---
output/**/*.pdf
output/**/*.log
output/**/*.aux
output/**/*.synctex.gz

# --- Fitted-model objects (large, regenerable from pipeline) ---
data/output/regressions/*.rds

# --- Frozen legacy project — do NOT commit. Contains restricted IFLS data ---
old/

# --- ~temp Office lock files ---
~$*
